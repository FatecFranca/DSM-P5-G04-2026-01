# MySQL + Prisma (API de usuários, porta 8001)
DATABASE_URL="mysql://root:SENHA@localhost:3306/pi5"
USERS_API_PORT=8001

# Parâmetros de treinamento
TEST_SIZE=0.2
RANDOM_STATE=42
